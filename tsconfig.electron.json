{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true
  },
  // Production mode (Task 11) imports the backend directly from `src/` (see
  // `electron/main.ts`'s dynamic imports), so this project now compiles `src` alongside
  // `electron` into its own self-contained `dist-electron` tree — kept entirely separate
  // from `tsconfig.json`'s own `dist` output, which the plain web-mode entrypoint uses.
  "include": ["electron", "src"],
  "exclude": ["node_modules", "dist", "dist-electron", "frontend", "tests"]
}
