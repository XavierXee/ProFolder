# Absolute path to the root music-production folder to scan.
MUSIC_ROOT=~/Music

# Path to the SQLite database file.
DB_PATH=./data/library.db

# Port for the local API server.
PORT=5175

# Network interface the API server binds to. Defaults to loopback-only (127.0.0.1), so the
# server is only reachable from this machine. There is NO authentication anywhere in this app —
# setting HOST=0.0.0.0 exposes the API (and everything it can read/write) to every device on
# your LAN with zero access control. Only set this if you deliberately want that exposure.
# Note: HOST=0 is treated by Node/the OS as equivalent to 0.0.0.0 (all interfaces) — the same
# exposure, even though it doesn't look like it at a glance.
# HOST=127.0.0.1
