{
  "name": "music-library-manager",
  "version": "1.0.0",
  "description": "Local macOS app for scanning, indexing, and tagging a music-production folder (Ableton projects, exports, drafts, sample libraries).",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:api": "tsx watch src/api/server.ts",
    "dev:frontend": "vite",
    "dev": "concurrently -n api,web -c blue,green --kill-others-on-fail \"npm:dev:api\" \"npm:dev:frontend\"",
    "scan": "tsx src/cli/scan.ts",
    "build:backend": "tsc -p tsconfig.json && mkdir -p dist/src/database/migrations && cp src/database/migrations/*.sql dist/src/database/migrations/",
    "build:frontend": "vite build",
    "build": "npm run build:backend && npm run build:frontend",
    "start": "node dist/src/api/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:frontend": "vitest run --project frontend",
    "test:backend": "vitest run --project backend",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e": "export E2E_RUN_ID=$(node -e \"console.log(require('crypto').randomUUID())\") && bddgen && playwright test",
    "test:e2e:headed": "export E2E_RUN_ID=$(node -e \"console.log(require('crypto').randomUUID())\") && bddgen && playwright test --headed",
    "playwright:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^44.4.3",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "playwright-bdd": "^9.2.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
